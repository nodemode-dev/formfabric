{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormFabric",
  "version": "0.9.0",
  "identifier": "ai.nodemode.formfabric",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formfabric",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Pattern making and garment simulation",
    "longDescription": "formfabric is a pattern making and garment design application in the NodeMode design system: 2D pattern drafting, a 3D viewport, and its own .ffbrc project files.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formfabric-engine"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["ffbrc"], "name": "formfabric Project", "description": "formfabric garment project", "role": "Editor", "mimeType": "application/x-formfabric" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formcompiler/releases/download/formfabric-updates/latest.json"]
    }
  }
}

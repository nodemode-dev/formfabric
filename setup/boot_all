#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FFB_ROOT"
if [ -z "${FFB_WINDOW_TOKEN:-}" ]; then
  FFB_WINDOW_TOKEN="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
fi
export FFB_WINDOW_TOKEN
pids=()
( cd backend && ./boot_backend ) &
pids+=($!)
( cd frontend && ./boot_frontend ) &
pids+=($!)
stop_tree() {
  local child
  for child in $(pgrep -P "$1" 2>/dev/null); do stop_tree "$child"; done
  kill "$1" 2>/dev/null || true
}
trap 'for pid in "${pids[@]}"; do stop_tree "$pid"; done' EXIT INT TERM
ffb_say "frontend http://localhost:${FFB_FRONTEND_PORT:-5280} · backend http://127.0.0.1:${FFB_PORT:-8280}"
wait

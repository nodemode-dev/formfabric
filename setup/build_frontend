#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FFB_ROOT/frontend"
if [ ! -d node_modules ]; then if [ -f package-lock.json ]; then npm ci; else npm install; fi; fi
if [ ! -f public/engine/ffb_wasm.wasm ] && command -v cargo >/dev/null 2>&1; then
  "$FFB_ROOT/setup/engine_wasm" || ffb_say "the browser engine was not built; the window will need the engine service"
fi
npm run build
ffb_say "built frontend/dist"

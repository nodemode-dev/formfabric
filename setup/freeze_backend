#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
ffb_rust_env
sign_engine() {
  local ent="$FFB_ROOT/src-tauri/entitlements.plist" f info signed=0 kept=0
  local files=() work link
  work="$(mktemp -d)"
  while IFS= read -r f; do
    if file -b "$f" | grep -Eq 'Mach-O.*(executable|shared library|bundle)'; then files+=("$f"); fi
  done < <(find "$1" -type f | awk -F/ '{print NF "\t" $0}' | sort -rn | cut -f2-)
  for f in "${files[@]}"; do
    info="$(codesign -d --verbose=4 "$f" 2>&1 || true)"
    if printf '%s\n' "$info" | grep -q '^Timestamp=' \
      && printf '%s\n' "$info" | grep -Eq '^CodeDirectory .*flags=[^ ]*runtime' \
      && ! printf '%s\n' "$info" | grep -q '^Signature=adhoc' \
      && [ "${f#*.framework/}" = "$f" ] \
      && { [ "$f" != "$1/formfabric-engine" ] || codesign -d --entitlements - "$f" 2>/dev/null | grep -q 'com.apple.security.cs.disable-library-validation'; }; then
      kept=$((kept + 1))
      continue
    fi
    if [ "${f#*.framework/}" = "$f" ]; then
      codesign --force --timestamp --options runtime --entitlements "$ent" --sign "$APPLE_SIGNING_IDENTITY" "$f"
    else
      cp -p "$f" "$work/${f##*/}"
      codesign --force --timestamp --options runtime --entitlements "$ent" --sign "$APPLE_SIGNING_IDENTITY" "$work/${f##*/}"
      mv -f "$work/${f##*/}" "$f"
    fi
    signed=$((signed + 1))
  done
  for f in "${files[@]}"; do
    [ "${f#*.framework/}" = "$f" ] || continue
    codesign --verify "$f" || ffb_die "engine file failed its signature check: $f"
  done
  while IFS= read -r link; do
    file -bL "$link" | grep -Eq 'Mach-O.*(executable|shared library|bundle)' || continue
    cp -L "$link" "$work/${link##*/}"
    codesign --verify --strict "$work/${link##*/}" || ffb_die "this engine library loses its signature when it is copied as a plain file, which is how the app bundle carries it: $link"
  done < <(find "$1" -type l)
  rm -rf "$work"
  ffb_say "engine signed: ${#files[@]} Mach-O files, $signed signed here, $kept already signed by PyInstaller"
}
ffb_venv
python -c "import PyInstaller" 2>/dev/null || ffb_die "PyInstaller missing, run ./formfabric install-desktop"
triple="$(ffb_target_triple)" || ffb_die "rustc not found; install Rust or set FFB_TARGET"
[ -f "$FFB_ROOT/frontend/dist/index.html" ] || "$FFB_ROOT/setup/build_frontend"
( cd "$FFB_ROOT/backend" && python -c "import ffb_engine, app; assert ffb_engine.version() == app.__version__" ) 2>/dev/null || "$FFB_ROOT/setup/engine_build"
cd "$FFB_ROOT/backend"
sep=":"
[ "$(ffb_os)" = windows ] && sep=";"
ext="$(ffb_exe)"
src="$(ffb_native_path "$FFB_ROOT")"
extra=()
[ -z "${FFB_PYI_ARCH:-}" ] || extra+=(--target-arch "$FFB_PYI_ARCH")
[ ! -f "$FFB_ROOT/setup/agents.py" ] || extra+=(--add-data "$src/setup/agents.py${sep}setup")
[ ! -d "$FFB_ROOT/.claude/skills" ] || extra+=(--add-data "$src/.claude/skills${sep}.claude/skills")
[ -z "$(ls "$FFB_ROOT/backend/plugins"/*.py 2>/dev/null)" ] || extra+=(--add-data "$src/backend/plugins${sep}plugins")
[ ! -d "$FFB_ROOT/assets/samples" ] || extra+=(--add-data "$src/assets/samples${sep}assets/samples")
if [ "$(ffb_os)" = windows ]; then extra+=(--hidden-import winpty); else extra+=(--hidden-import ptyprocess); fi
mode=--onefile
if [ "$(ffb_os)" = macos ]; then
  mode=--onedir
  [ -z "${APPLE_SIGNING_IDENTITY:-}" ] || extra+=(--codesign-identity "$APPLE_SIGNING_IDENTITY" --osx-entitlements-file "$FFB_ROOT/src-tauri/entitlements.plist")
fi
rm -rf build/pyinstaller dist-engine
pyinstaller --noconfirm --clean "$mode" --name formfabric-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
  --add-data "$src/frontend/dist${sep}frontend_dist" \
  --collect-submodules app --collect-submodules uvicorn --collect-all ffb_engine \
  --hidden-import app.services.cmd_terminal --hidden-import app.services.claude_code --hidden-import app.services.cmd_chat \
  "${extra[@]}" \
  "$src/backend/formfabric_engine.py"
if [ "$mode" = --onedir ]; then
  out="$FFB_ROOT/src-tauri/engine"
  rm -rf "$out"
  cp -R dist-engine/formfabric-engine "$out"
  [ -z "${APPLE_SIGNING_IDENTITY:-}" ] || sign_engine "$out"
  "$out/formfabric-engine" --selfcheck
  ffb_say "engine folder ready: $out"
  exit 0
fi
mkdir -p "$FFB_ROOT/src-tauri/binaries"
out="$FFB_ROOT/src-tauri/binaries/formfabric-engine-${triple}${ext}"
cp "dist-engine/formfabric-engine${ext}" "$out"
"$out" --selfcheck
ffb_say "sidecar ready: $out"

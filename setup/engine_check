#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
ffb_rust_env
command -v cargo >/dev/null 2>&1 || ffb_die "cargo not found; install Rust from https://rustup.rs"
cd "$FFB_ROOT/native"
cargo check --workspace --all-targets
if cargo clippy --version >/dev/null 2>&1; then cargo clippy --workspace --all-targets -- -D warnings; fi
ffb_say "engine check clean"

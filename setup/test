#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"
which="${1:-all}"
[ $# -gt 0 ] && shift
case "$which" in
  all|unit|engine) ;;
  *) ffb_say "unknown test layer: $which (use unit, engine or nothing for all)"; exit 2 ;;
esac
fail=0
run() { ffb_say "$1"; shift; "$@" || fail=1; }
wants() { [ "$which" = all ] || [ "$which" = "$1" ]; }
if wants unit; then
  [ -d "$FFB_ROOT/frontend/node_modules/vitest" ] || ffb_die "frontend not installed, run ./formfabric install"
  cd "$FFB_ROOT/frontend"
  run "interface logic (vitest)" npx vitest run "$@"
fi
if wants engine; then
  py="$(ffb_venv_python)" || ffb_die "backend venv missing, run ./formfabric install"
  "$py" -c "import pytest, httpx" >/dev/null 2>&1 || ffb_die "pytest and httpx missing from the backend venv, run: $py -m pip install pytest httpx"
  cd "$FFB_ROOT/backend"
  run "service (pytest)" "$py" -m pytest tests -q -p no:cacheprovider "$@"
fi
exit "$fail"

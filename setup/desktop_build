#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
ffb_rust_env
"$FFB_ROOT/setup/build_frontend"
"$FFB_ROOT/setup/freeze_backend"
cd "$FFB_ROOT"
[ -f src-tauri/icons/icon.icns ] || frontend/node_modules/.bin/tauri icon assets/formfabric_icon.png
frontend/node_modules/.bin/tauri build "$@"
ffb_say "bundles are in src-tauri/target/release/bundle"

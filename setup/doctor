#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"
fail=0
ok() { printf '  ok     %s\n' "$1"; }
bad() { printf '  FAIL   %s · %s\n' "$1" "$2"; fail=1; }
warn() { printf '  warn   %s · %s\n' "$1" "$2"; }
ffb_say "doctor · $(ffb_os)"
if command -v node >/dev/null 2>&1 && node -e 'const [m,n]=process.versions.node.split(".").map(Number);process.exit((m===20&&n>=19)||(m===22&&n>=12)||m>=23?0:1)'; then ok "node $(node -v)"; else bad "node" "Node 20.19+ or 22.12+ is required"; fi
if command -v npm >/dev/null 2>&1; then ok "npm"; else bad "npm" "install npm"; fi
if py="$(ffb_python)"; then ok "python $("$py" -V 2>&1 | awk '{print $2}')"; else bad "python" "Python 3.12+ is required"; fi
if command -v cargo >/dev/null 2>&1; then ok "rust $(rustc --version | awk '{print $2}')"; else bad "rust" "the engine needs https://rustup.rs"; fi
if [ -f "$FFB_ROOT/backend/venv/bin/activate" ] || [ -f "$FFB_ROOT/backend/venv/Scripts/activate" ]; then ok "backend venv"; else warn "backend venv" "run ./formfabric install"; fi
if [ -d "$FFB_ROOT/frontend/node_modules" ]; then ok "frontend node_modules"; else warn "frontend deps" "run ./formfabric install"; fi
if [ -f "$FFB_ROOT/frontend/public/engine/ffb_wasm.wasm" ]; then ok "browser engine"; else warn "browser engine" "run ./formfabric engine wasm"; fi
if [ "$(ffb_os)" = linux ]; then
  if pkg-config --exists webkit2gtk-4.1 2>/dev/null; then ok "webkit2gtk-4.1 for desktop builds"; else warn "webkit2gtk-4.1" "desktop builds need ./formfabric install-desktop's apt list"; fi
fi
if [ -n "${py:-}" ] && (cd "$FFB_ROOT" && "$py" -I setup/i18n.py check >/dev/null 2>&1); then ok "interface translations complete"; else warn "interface translations" "run ./formfabric i18n check; every table should cover strings.json"; fi
for port in "${FFB_FRONTEND_PORT:-5280}" "${FFB_PORT:-8280}"; do
  if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then warn "port $port" "already in use"; else ok "port $port free"; fi
done
if [ "$fail" = 0 ]; then ffb_say "ready"; else ffb_say "fix the FAIL lines above"; fi
exit "$fail"
